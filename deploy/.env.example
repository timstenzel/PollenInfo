# Copy to /opt/polleninfo/deploy/.env on the server (deploy.sh rewrites SERVER_TAG on every deploy).
# The real .env is never committed.

# The image tag to run: a commit SHA published by .github/workflows/server.yml.
SERVER_TAG=0000000000000000000000000000000000000000

# Where install-secrets.sh put the secret files.
SECRETS_DIR=/opt/polleninfo/secrets
