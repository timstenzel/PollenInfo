<?xml version="1.0" encoding="utf-8"?>
<!--
  English, the default for every device language the app does not support. values-de, values-fr and
  values-it must hold exactly the same keys with the same placeholders: ./gradlew
  :composeApp:checkTranslations fails otherwise.
-->
<resources>
    <!-- Bottom navigation: the tabs are icon-only, so these are their only names. -->
    <string name="nav_home">Home</string>
    <string name="nav_all_stations">All stations</string>
    <string name="nav_diary">Diary</string>
    <string name="nav_alarms">Alarms</string>
    <string name="nav_settings">Settings</string>

    <!-- Settings -->
    <string name="settings_title">Settings</string>
    <string name="settings_section_language">Language</string>
    <string name="settings_language_action">Change the language</string>
    <!-- The other choices are each named in their own language, in code. -->
    <string name="settings_language_system">System default</string>
    <string name="settings_language_restart_note">The new language applies the next time you open the app.</string>
    <string name="settings_section_impressum">Impressum</string>
    <!-- %1$s is the developer's name. -->
    <string name="settings_developed_by">Developed by %1$s</string>
    <string name="settings_email_action">Write an email</string>
    <string name="settings_section_data_source">Data source</string>
    <!-- The wording MeteoSwiss's terms of use prescribe for this language. Do not rephrase. -->
    <string name="settings_data_source_attribution">Source: MeteoSwiss</string>
    <string name="settings_meteoswiss_url">https://www.meteoswiss.admin.ch</string>
    <string name="settings_meteoswiss_link_action">Open the MeteoSwiss website</string>
    <string name="settings_data_source_disclaimer">PollenInfo is an independent app. It is not affiliated with or endorsed by MeteoSwiss.</string>
    <!-- %1$s is the version name, %2$d the build number: "Version 1.0.0 (1)". -->
    <string name="settings_version">Version %1$s (%2$d)</string>

    <!-- Errors: core/ui/error. In an action's context (save, delete, pause, resume an alarm) the
         action sentence comes first, then the reason. -->
    <string name="error_network">Couldn’t reach the server. Check your internet connection and try again.</string>
    <string name="error_server_unavailable">The service is having problems right now. Please try again later.</string>
    <string name="error_not_found">This information isn’t available right now.</string>
    <string name="error_alarm_not_found">This alarm no longer exists.</string>
    <string name="error_no_station_selected">No measuring station is selected.</string>
    <string name="error_no_readings">No station’s reading could be loaded. Please try again later.</string>
    <string name="error_no_stations">No measuring stations are available right now.</string>
    <string name="error_push_unavailable">Push notifications aren’t available on this device yet.</string>
    <string name="error_alarm_limit_reached">You’ve reached the maximum number of alarms. Delete one to create another.</string>
    <string name="error_invalid_alarm">The server didn’t accept this alarm. Please check your entries and try again.</string>
    <string name="error_unknown">Something went wrong. Please try again.</string>
    <string name="error_action_save_alarm">Couldn’t save the alarm.</string>
    <string name="error_action_delete_alarm">Couldn’t delete the alarm.</string>
    <string name="error_action_pause_alarm">Couldn’t pause the alarm.</string>
    <string name="error_action_resume_alarm">Couldn’t resume the alarm.</string>

    <!-- Home -->
    <string name="home_feeling_save_error">Your answer couldn’t be saved. Please try again.</string>
    <string name="home_load_failed">The pollen readings could not be loaded.</string>
    <!-- %1$s is the pollen type with the worst severity, which sets the overall level. -->
    <string name="home_driven_by">Driven by %1$s</string>
    <string name="home_feeling_question">How do you feel today?</string>
    <!-- The close button of the feeling prompt, spoken only. -->
    <string name="home_feeling_dismiss">Not today</string>

    <!-- All stations. The screen's title is nav_all_stations, so it matches the tab's name. -->
    <string name="all_stations_load_failed">The stations could not be loaded.</string>
    <!-- Row states: short, they share a fixed-width column with the severity words. -->
    <string name="all_stations_row_loading">Loading…</string>
    <string name="all_stations_row_no_reading">No reading</string>
    <string name="all_stations_detail_loading">Loading this station’s reading…</string>
    <string name="all_stations_detail_unavailable">No reading available for this station right now.</string>
    <!-- Spoken: the warning icon on a row whose reading is old. -->
    <string name="all_stations_stale">Reading not current</string>
    <!-- Spoken state of a station row. -->
    <string name="all_stations_expanded">Expanded</string>
    <string name="all_stations_collapsed">Collapsed</string>
    <!-- Spoken description of the map; %1$d is the number of stations. -->
    <plurals name="all_stations_map_description">
        <item quantity="one">Map of %1$d pollen station. Select a station in the list below.</item>
        <item quantity="other">Map of %1$d pollen stations. Select a station in the list below.</item>
    </plurals>

    <!-- A reading (core/ui/severity), on Home and in an expanded All stations row. %1$s is a time
         (HH:mm) or a date ("29 July"); the refresh's %2$s is the time. -->
    <string name="reading_age_fresh">Data from %1$s</string>
    <string name="reading_age_stale_today">Data from %1$s today</string>
    <string name="reading_age_stale_earlier">Data from %1$s</string>
    <string name="reading_not_current">These readings are not current.</string>
    <string name="reading_refreshed_today">Refreshed %1$s</string>
    <string name="reading_refreshed_earlier">Refreshed %1$s, %2$s</string>
    <string name="reading_all_species">All species</string>
    <!-- %1$s is the unit as the server sends it, e.g. "grains/m3". -->
    <string name="reading_concentration_unit">concentration in %1$s</string>
    <!-- A pollen type the station does not measure — not the same as "None". -->
    <string name="reading_no_data">No data</string>

    <!-- Shared by several screens. -->
    <string name="common_retry">Retry</string>
    <string name="common_back">Back</string>
    <string name="common_cancel">Cancel</string>

    <!-- Station picker: core/stationpicker, shared by onboarding and the change-station screen. -->
    <string name="station_picker_load_failed">The station list could not be loaded.</string>
    <string name="station_picker_use_my_location">Use my location</string>
    <string name="station_picker_label">Station</string>
    <string name="station_picker_location_denied">Location permission is off. Enable it in Settings to find your nearest station.</string>
    <string name="station_picker_location_unavailable">Your location could not be determined. Please pick a station manually.</string>
    <string name="station_picker_save_error">Could not save your selection. Please try again.</string>

    <!-- Onboarding -->
    <string name="onboarding_title">Welcome to PollenInfo</string>
    <string name="onboarding_intro">Choose the measuring station you want pollen levels for.</string>
    <string name="onboarding_continue">Continue</string>

    <!-- Settings: default station, and the screen that changes it. -->
    <string name="settings_section_station">Default station</string>
    <string name="settings_station_action">Change the default station</string>
    <string name="settings_station_not_set">Not set</string>
    <string name="change_station_title">Default station</string>
    <string name="change_station_intro">Home shows the pollen levels at this station. Your alarms and the Diary keep their own stations.</string>
    <string name="change_station_save">Save</string>

    <!-- Vocabulary: pollen types (keyed by the server's species ids), severity and feeling words. -->
    <string name="species_alder">Alder</string>
    <string name="species_birch">Birch</string>
    <string name="species_hazel">Hazel</string>
    <string name="species_beech">Beech</string>
    <string name="species_ash">Ash</string>
    <string name="species_oak">Oak</string>
    <string name="species_grasses">Grasses</string>
    <string name="severity_none">None</string>
    <string name="severity_low">Low</string>
    <string name="severity_moderate">Moderate</string>
    <string name="severity_high">High</string>
    <string name="severity_very_high">Very high</string>
    <string name="alarm_minimum_any">Any</string>
    <string name="feeling_very_bad">Very bad</string>
    <string name="feeling_bad">Bad</string>
    <string name="feeling_good">Good</string>
    <string name="feeling_very_good">Very good</string>

