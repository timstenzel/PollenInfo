<?xml version="1.0" encoding="utf-8"?>
<!--
  What the shared code needs from the app it is merged into: its permissions and the push service.
  The application itself — entry points, theme, launcher and locale config — is :androidApp's.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Approximate location only. ACCESS_FINE_LOCATION is deliberately absent: the app distinguishes
      between 15 stations spread across a country, so a coarse fix is always precise enough, and
      asking for more than a feature needs is a permission the user is right to refuse.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Pollen alarms. A runtime permission from API 33 on; below that the declaration is ignored and
      notifications are on unless the user switched them off in system settings.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          FCM addresses this install by its Firebase Installation ID (register() / onRegistered)
          rather than by a registration token, which firebase-messaging 26 deprecates.
        -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />

        <!-- Receives every pollen alarm (data-only messages) and rotated push tokens. -->
        <service
            android:name="ch.stenzel.tim.polleninfo.core.push.PollenFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
