<?xml version="1.0" encoding="utf-8"?>
<!--
  Pollen grain icon — 108×108dp canvas, safe zone 18–90dp.
  Design: round body (r=19) + 6 spikes at 60° intervals (tip at r=32) + 3 aperture pores.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 6 spikes, each a leaf-shaped bezier, rotated 60° apart around center (54,54) -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path android:fillColor="#FFFFFF"
            android:pathData="M50.5,35 Q54,21 57.5,35 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="60">
        <path android:fillColor="#FFFFFF"
            android:pathData="M50.5,35 Q54,21 57.5,35 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path android:fillColor="#FFFFFF"
            android:pathData="M50.5,35 Q54,21 57.5,35 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:fillColor="#FFFFFF"
            android:pathData="M50.5,35 Q54,21 57.5,35 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="240">
        <path android:fillColor="#FFFFFF"
            android:pathData="M50.5,35 Q54,21 57.5,35 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="300">
        <path android:fillColor="#FFFFFF"
            android:pathData="M50.5,35 Q54,21 57.5,35 Z" />
    </group>

    <!-- Main body circle: center (54,54), radius 19 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,35 A19,19 0 1,0 54,73 A19,19 0 1,0 54,35 Z" />

    <!-- 3 aperture pores at 90°/210°/330° from top, radius 15 from center, r=3 each -->
    <!-- East  (69, 54) -->
    <path android:fillColor="#5B631D"
        android:pathData="M69,51 A3,3 0 1,0 69,57 A3,3 0 1,0 69,51 Z" />
    <!-- Lower-left  (46.5, 67) -->
    <path android:fillColor="#5B631D"
        android:pathData="M46.5,64 A3,3 0 1,0 46.5,70 A3,3 0 1,0 46.5,64 Z" />
    <!-- Upper-left  (46.5, 41) -->
    <path android:fillColor="#5B631D"
        android:pathData="M46.5,38 A3,3 0 1,0 46.5,44 A3,3 0 1,0 46.5,38 Z" />

</vector>
