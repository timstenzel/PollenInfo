<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 (API 31) and later. Two files never leave this install:
  - the device token (:composeApp's polleninfo_device DataStore), this install's identity on the
    backend: copied to a cloud backup or a new phone, two installs would share one identity. Leaving
    it out makes a restored install register afresh;
  - the login (polleninfo_session): a restored backup or a device transfer must not carry a logged-in
    account to another phone. A restored install starts logged out.
  Everything else is backed up as before.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/polleninfo_device.preferences_pb" />
        <exclude domain="file" path="datastore/polleninfo_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/polleninfo_device.preferences_pb" />
        <exclude domain="file" path="datastore/polleninfo_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
