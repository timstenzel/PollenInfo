// Settings shared by Debug and Release. Per-configuration values live in Debug.xcconfig and
// Release.xcconfig, which include this file first.
//
// "//" starts a comment in an xcconfig, so a URL value is written as http:/$()/host — $() expands to
// nothing and keeps the two slashes apart.

// Empty until the Apple Developer Program membership exists; simulator builds are signed to run
// locally ("-"), device builds and archives need a team (or CODE_SIGNING_ALLOWED=NO).
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -

PRODUCT_NAME = PollenInfo
MARKETING_VERSION = 1.0.0
// A whole number: IosAppInfo hides the version line otherwise.
CURRENT_PROJECT_VERSION = 1

// Not lower: Skiko's ICU data in ComposeApp.framework is built for 18.5, and linking it into an
// older target is a linker warning.
IPHONEOS_DEPLOYMENT_TARGET = 18.5
// Apple-silicon simulators only: there is no iosX64 Kotlin target (Compose Multiplatform 1.12).
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0

INFOPLIST_FILE = iosApp/Info.plist
GENERATE_INFOPLIST_FILE = NO
// Lets Info.plist leave keys out per configuration (#if); traditional mode leaves "//" in the
// plist's DOCTYPE URL alone.
INFOPLIST_PREPROCESS = YES
INFOPLIST_OTHER_PREPROCESSOR_FLAGS = -traditional

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME =

// The Kotlin framework built by the "Compile Kotlin" phase (embedAndSignAppleFrameworkForXcode).
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../composeApp/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)
OTHER_LDFLAGS = $(inherited) -framework ComposeApp
// The Gradle call reads and writes outside the sandbox's allowed paths.
ENABLE_USER_SCRIPT_SANDBOXING = NO
