#include "Base.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_BASE)
PRODUCT_DISPLAY_NAME = PollenInfo

// Optional, git-ignored per-developer settings (signing team, throwaway identifier); see
// Local.xcconfig.example.
#include? "Local.xcconfig"

// Always production, even when Local.xcconfig sets an address: it comes after the include.
// In xcconfig `//` starts a comment, hence `$()` between the slashes.
API_BASE_URL = https:/$()/api.polleninfo.ch
